# Processed intermediates only. `assets/intake/<char>/` itself IS tracked —
# that is where delivered art is uploaded, so it has to survive a git push —
# but `_processed/` is derived output that tools/intake.py regenerates, and
# tools/intake_import.py copies the approved frames into sprites/assets/.
assets/intake/_processed/

# Generated review boards (size/facing contact sheets) — regenerate on demand
# with tools/size_board.py, tools/size_review.py, tools/facing_review.py.
tools/debug/
tools/__pycache__/

# The untouched plates tools/effects_intake.py moves out of assets/intake/ once
# it has landed them. Kept on disk so a trim can be redone at a different
# threshold without regenerating the art, and NOT kept in git: the trim discards
# only fully-transparent margin, so the archive is a byte-for-byte-equivalent
# picture at roughly twice the size, and the delivered plates are already in
# history under assets/intake/ where they were uploaded.
assets/reference/

# Local dev
node_modules/
package-lock.json
_shots/

# Generated pose rig sheets (tools/pose_rig_sheet.mjs) and scratch output.
debug/
tmp/

# The model smokes BUILD their test rig and delete it again (smoke_render3d.mjs
# and smoke_billboard.mjs, TEST_CHAR = "__smoketest"): it is generated from
# tools/billboard_test_rig.mjs on every run, imported through the real intake,
# and removed in cleanup. It was tracked by accident, so every session that ran
# a smoke saw a phantom deletion in `git status` and had to decide whether it
# mattered.
render3d/assets/__smoketest/
render3d/intake/__smoketest/
billboards/assets/__smoketest/
billboards/intake/__smoketest/
render3d/docs/reference/_views/

# Written by the deploy workflow ("Stamp the build") so the published site can
# report which commit it is. Per-deploy, never committed — see src/deploystamp.js.
version.json
